{
  "name": "gitid",
  "displayName": "GitID",
  "description": "Manage and Switch Multiple Git Identities",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitid-sidebar",
          "title": "GitID",
          "icon": "$(account)"
        }
      ]
    },
    "views": {
      "gitid-sidebar": [
        {
          "id": "gitid-profiles-view",
          "name": "Profiles",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "gitid.switchProfile",
        "title": "Switch Git Profile",
        "category": "GitID"
      },
      {
        "command": "gitid.createProfile",
        "title": "Create Git Profile",
        "category": "GitID",
        "icon": "$(add)"
      },
      {
        "command": "gitid.manageProfiles",
        "title": "Manage Git Profiles",
        "category": "GitID"
      },
      {
        "command": "gitid.applyProfileFromTree",
        "title": "Apply Profile",
        "category": "GitID",
        "icon": "$(check)"
      },
      {
        "command": "gitid.editProfileFromTree",
        "title": "Edit Profile",
        "category": "GitID",
        "icon": "$(edit)"
      },
      {
        "command": "gitid.deleteProfileFromTree",
        "title": "Delete Profile",
        "category": "GitID",
        "icon": "$(trash)"
      },
      {
        "command": "gitid.saveActiveAsProfile",
        "title": "Register Active Profile",
        "category": "GitID",
        "icon": "$(add)"
      },
      {
        "command": "gitid.refreshTree",
        "title": "Refresh GitID Profiles",
        "category": "GitID",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitid.refreshTree",
          "when": "view == gitid-profiles-view",
          "group": "navigation@1"
        },
        {
          "command": "gitid.createProfile",
          "when": "view == gitid-profiles-view",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gitid.applyProfileFromTree",
          "when": "view == gitid-profiles-view && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "gitid.editProfileFromTree",
          "when": "view == gitid-profiles-view && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "gitid.deleteProfileFromTree",
          "when": "view == gitid-profiles-view && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "gitid.saveActiveAsProfile",
          "when": "view == gitid-profiles-view && viewItem == activeConfig-unregistered",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
